# Visa marche sans aucune clé : il utilise alors les sources mises en cache
# pour la démonstration. Renseignez ces valeurs pour interroger les API réelles.

# Compte PISTE (https://piste.gouv.fr/registration), abonné à Légifrance et JUDILIBRE
VITE_PISTE_CLIENT_ID=
VITE_PISTE_CLIENT_SECRET=
# "sandbox" (immédiat) ou "production"
VITE_PISTE_ENV=sandbox

# Mistral (raisonnement visible : Magistral)
VITE_MISTRAL_API_KEY=
